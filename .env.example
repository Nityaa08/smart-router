# ─────────────────────────────────────────────────────────────────────────────
#  Smart Router — Environment Configuration
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Provider ─────────────────────────────────────────────────────────────────
# "ollama"       → fully local, no accounts (requires Ollama + models installed)
# "openrouter"   → free cloud API, no credit card (recommended for deployment)
# "groq"         → free cloud API (console.groq.com)
# "openai_compat" → any OpenAI-compatible API (Cerebras, Together AI, etc.)
PROVIDER=ollama

# ── Ollama (PROVIDER=ollama) ──────────────────────────────────────────────────
# Run: brew install ollama && ollama serve
# Pull: ollama pull llama3.2:1b && ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_SIMPLE_MODEL=llama3.2:1b
OLLAMA_MEDIUM_MODEL=llama3.1:8b
OLLAMA_COMPLEX_MODEL=llama3.1:8b

# ── OpenRouter (PROVIDER=openrouter) — RECOMMENDED FOR DEPLOYMENT ────────────
# Free account at openrouter.ai — no credit card needed
# Free models end in ":free". These were listed on 2026-11-02; the free list
# changes often. Current list: https://openrouter.ai/api/v1/models?max_price=0
OPENROUTER_API_KEY=
OPENROUTER_SIMPLE_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_MEDIUM_MODEL=google/gemma-4-31b-it:free
OPENROUTER_COMPLEX_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ── Groq (PROVIDER=groq) ─────────────────────────────────────────────────────
# Free API key at: https://console.groq.com → API Keys
# Production models on 2026-11-02: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_SIMPLE_MODEL=openai/gpt-oss-20b
GROQ_MEDIUM_MODEL=openai/gpt-oss-120b
GROQ_COMPLEX_MODEL=openai/gpt-oss-120b

# ── Generic OpenAI-compatible (PROVIDER=openai_compat) ───────────────────────
# Works with Cerebras (cerebras.ai), Together AI, etc.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_SIMPLE_MODEL=
OPENAI_COMPAT_MEDIUM_MODEL=
OPENAI_COMPAT_COMPLEX_MODEL=

# ── Database ──────────────────────────────────────────────────────────────────
# Local (Docker Compose sets this automatically)
DATABASE_URL=postgresql+asyncpg://smartrouter:smartrouter@db:5432/smartrouter
# Railway injects this automatically as DATABASE_URL — the app auto-converts the scheme

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Limit on POST /v1/chat/completions, per API key (or per client IP when no key is sent).
# slowapi syntax, e.g. 60/minute
RATE_LIMIT=60/minute
# Where the counts live. memory:// counts per process; a redis:// URL shares one count across
# all workers (Docker Compose sets this to the bundled Redis). Falls back to memory if Redis is down.
RATE_LIMIT_STORAGE=memory://

# Optional. When set, /v1/chat/completions and /analytics require
# "Authorization: Bearer <key>" or "X-API-Key: <key>". Leave empty for local dev.
ROUTER_API_KEY=

# CORS: comma-separated list of allowed origins, or "*" for all (dev only)
# Production example: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=*
